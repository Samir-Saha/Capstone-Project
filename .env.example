# Copy to .env and fill in. Never commit real values.

# development | test | production
REPS_ENV=development

# --- Backend (apps/api) ---
# Shared secret the background worker uses to call /internal/* routes
INTERNAL_API_TOKEN=change-me
# Comma-separated origins allowed to call the API
WEB_ORIGINS=http://localhost:3000

# Supabase (server side). The service role key bypasses RLS: backend only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Code execution. Leave empty in development to use the local subprocess runner,
# which is NOT a sandbox. Required in production.
JUDGE0_URL=
JUDGE0_API_KEY=

# Language model (provider-independent adapter, coming next)
LLM_PROVIDER=anthropic
LLM_MODEL=
LLM_API_KEY=

# Background jobs
REDIS_URL=redis://localhost:6379/0

# --- Frontend (apps/web) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000
